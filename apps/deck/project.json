{
  "name": "deck",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/deck/src",
  "tags": ["type:app", "scope:deck"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/deck",
        "browser": "apps/deck/src/main.ts",
        "tsConfig": "apps/deck/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/deck/public"
          },
          {
            "glob": "**/*",
            "input": "libs/ui/src/assets/icons",
            "output": "assets/shared/icons"
          },
          {
            "glob": "**/*",
            "input": "libs/ui/src/assets/images",
            "output": "assets/shared/images"
          },
          {
            "glob": "**/*",
            "input": "libs/ui/src/assets/fonts",
            "output": "assets/shared/fonts"
          }
        ],
        "styles": ["libs/shared/ui/src/scss/_init.scss", "apps/deck/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/ui/src/scss"]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "deck:build:production"
        },
        "development": {
          "buildTarget": "deck:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "deck:build",
        "staticFilePath": "dist/apps/deck/browser",
        "spa": true
      }
    }
  }
}
