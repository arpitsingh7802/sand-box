{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@sand-box/ui": [
        "./libs/shared/ui/src/index.ts"
      ],
      "@sand-box/data-access": [
        "./libs/shared/data-access/src/index.ts"
      ],
      "@sand-box/util": [
        "./libs/shared/util/src/index.ts"
      ],
      "@sand-box/types": [
        "./libs/shared/types/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
